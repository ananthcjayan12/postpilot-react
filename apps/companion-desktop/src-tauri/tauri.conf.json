{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PostPilot Companion",
  "version": "0.1.0",
  "identifier": "com.postpilot.companion",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "PostPilot Companion", "width": 760, "height": 780, "minWidth": 540, "minHeight": 600 }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'none'" }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "shortDescription": "Use your local AI CLI with PostPilot",
    "macOS": { "minimumSystemVersion": "10.15", "signingIdentity": "-" },
    "windows": { "nsis": { "installMode": "currentUser" }, "webviewInstallMode": { "type": "embedBootstrapper" } }
  }
}
