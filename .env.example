# Legacy Express runtime only. Cloudflare development uses .dev.vars.example.
# PostPilot server
PORT=8787
APP_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:8787

# Required to encrypt OAuth tokens at rest.
# `npm run setup` generates this automatically.
APP_ENCRYPTION_KEY=

# Public HTTPS origin that Meta can fetch uploaded media from.
# For local development, run a free tunnel such as:
#   cloudflared tunnel --url http://localhost:8787
# Then paste the https://....trycloudflare.com URL below and restart the API.
PUBLIC_BASE_URL=

# Google / YouTube OAuth (Web application credential)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/api/oauth/google/callback

# Facebook Page OAuth (independent)
# Required scopes: pages_show_list, pages_read_engagement, pages_manage_posts.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8787/api/oauth/facebook/callback

# Instagram API with Instagram Login (independent)
# Required scopes: instagram_business_basic, instagram_business_content_publish.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8787/api/oauth/instagram/callback

# Shared Meta Graph version for Facebook and direct Instagram Graph calls.
META_GRAPH_VERSION=v25.0

# Optional: pin one Facebook Page if your user manages several Pages.
META_PAGE_ID=

# Legacy Facebook aliases. New setups should use FACEBOOK_* above.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8787/api/oauth/meta/callback
