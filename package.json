{
  "name": "postpilot",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "workspaces": [
    "apps/web",
    "apps/api",
    "apps/worker",
    "packages/shared"
  ],
  "scripts": {
    "setup": "node scripts/setup-worker.mjs",
    "setup:legacy": "node scripts/setup.mjs",
    "dev": "concurrently -n API,WEB -c cyan,blue \"wrangler dev\" \"npm run dev -w apps/web\"",
    "dev:legacy": "concurrently \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build -w apps/web && wrangler deploy --dry-run --outdir .worker-build",
    "typecheck": "npm run typecheck -w apps/worker && npm run typecheck -w apps/web",
    "test": "vitest run && node --test scripts/cloudflare/*.test.mjs",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "deploy:prepare": "node scripts/cloudflare/provision.mjs",
    "deploy": "node scripts/cloudflare/deploy.mjs",
    "start": "wrangler dev"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1138.0",
    "@aws-sdk/lib-storage": "^3.1138.0",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260923.1",
    "concurrently": "^9.1.2",
    "jsonc-parser": "^3.3.1",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.136.3"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "sharp": "^0.35.4"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "hono": "^4.13.8",
    "jose": "^6.2.12",
    "zod": "^4.6.5"
  }
}
